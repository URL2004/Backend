# ── 엔진 LLM 백엔드 선택 ───────────────────────────────
# api        : Anthropic API 직접 호출 (ANTHROPIC_API_KEY 필요) — 프로덕션/최종 acceptance
# claudecode : 내 Claude Code 구독(Sonnet)으로 호출 (키 불필요) — 로컬 엔진 테스트
LLM_BACKEND=claudecode

# api 백엔드용
ANTHROPIC_API_KEY=

# ── 서버 구동(server.js)용 — 로컬 엔진 테스트엔 불필요 ──
# 미설정 시 Firebase 비활성(엔진 단독 테스트 모드). 프로덕션/staging에서만 설정.
FIREBASE_SERVICE_ACCOUNT=
CORS_ORIGINS=
CRON_SECRET=
