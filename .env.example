# 레거시 Anthropic API 개발 경로용. 운영 휴머나이징 v2는 OpenAI를 사용한다.
ANTHROPIC_API_KEY=

# GPT 운영 엔진 설정은 아래 "GPT 운영 엔진(runtime config fallback)" 섹션에서 관리한다.

# ── 서버 구동(server.js)용 — 로컬 엔진 테스트엔 불필요 ──
# 미설정 시 Firebase 비활성(엔진 단독 테스트 모드). 프로덕션/staging에서만 설정(서비스 계정 JSON 통째로).
FIREBASE_SERVICE_ACCOUNT=
# 기본 허용 도메인(gpkorea.ai.kr) 외 추가 origin — 콤마 구분 (예: https://staging.gpkorea.ai.kr)
CORS_ORIGINS=
# staging/preview 전용 origin suffix — 예: .vercel.app. 프로덕션에서는 비워둘 것.
CORS_ORIGIN_SUFFIXES=
# 정기결제 갱신 cron 호출 인증용 시크릿
CRON_SECRET=
# 토스페이먼츠 시크릿 키(결제·환불) — 프로덕션은 live_, 테스트는 test_ 키
TOSS_SECRET_KEY=
# Toss 웹훅 처리용 내부 검증 시크릿. 미설정 시 /toss/webhook은 fail-close(503)한다.
# Toss 콘솔/프록시에서 x-gp-webhook-secret 또는 Authorization: Bearer 헤더로 같은 값을 전달해야 한다.
TOSS_WEBHOOK_SECRET=
PORT=3100

# ── 운영 점검 모드 ───────────────────────────────────
# true면 비용/결제/쓰기성 API를 503으로 닫는다. /healthz, /api/health, /kakao-login은 허용.
# 테스트 브라우저에서 localStorage.gp_maintenance_bypass에 같은 값을 넣으면 X-Maintenance-Bypass 헤더로 우회 가능.
# 예: localStorage.setItem('gp_maintenance_bypass','랜덤긴시크릿')
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_SECRET=

# ── 로컬 개발 전용 — 프로덕션에서 절대 설정 금지 ──
# FIREBASE_SERVICE_ACCOUNT가 비어 있을 때만 동작(인증 우회). Firebase 설정 시 자동 무시되지만 켜두지 말 것.
# DEV_NO_AUTH=1

# ── 레거시 PDF 직접 분석 API ───────────────────────
# 프론트는 브라우저에서 PDF 텍스트를 추출한 뒤 /analyze를 호출한다.
# /analyze-pdf는 과금 산식이 달라 운영 기본값에서 닫혀 있으며, 호환 필요 시에만 1로 켠다.
# ENABLE_LEGACY_ANALYZE_PDF=1

# ── AI 감지(/detect-report) — 무료 미끼 상품 ──
# 사용자(로그인 uid, 비로그인 IP)당 일일 무료 감지 횟수. 기본 5. 감지 1회 원가 ≈ LLM 판정+1문장 미리보기.
# DETECT_DAILY_CAP=5
# 테스트 오픈 임시 보정: 로그인 사용자의 최근 작업내역(history) 중 휴머나이저 결과와 감지 입력이
# 정확히 일치하면 감지 확률을 소폭 보정한다. 원점수(rawProbability)와 보정 메타는 저장/관리자 조회에 남긴다.
# 관리자 페이지 저장값(adminSettings/detectCalibration)이 있으면 env보다 우선 적용된다. 정식 오픈 전 반드시 재검토.
# DETECT_HISTORY_CALIBRATION=0
# DETECT_HISTORY_CALIBRATION_LIMIT=50
# DETECT_HISTORY_CALIBRATION_FACTOR=0.15
# DETECT_HISTORY_CALIBRATION_MAX_REDUCTION=12
# DETECT_HISTORY_CALIBRATION_FLOOR=35

# ── 변환 job(/transform) 비용 방어 — 미설정 시 기본값 ──
# 전역 동시 실행 상한(LLM 점유 job 수). formal(고급 피하기·재구성) 기본 3 — 인스턴스 사양·API rate limit에 맞춰 조정.
# RESTRUCTURE_MAX_ACTIVE=3
# blog(기본 피하기) 전역 동시 상한. 짧고 저원가라 별도 풀, 기본 4.
# BLOG_MAX_ACTIVE=4
# 사용자당 일일 시작 횟수(취소·차단 포함 — 최악 비용 캡). formal만 적용, 기본 8.
# RESTRUCTURE_DAILY_CAP=8
# 차단 시 자동 폴백(기본 ON): 고급 재구성이 게이트에 막히면 원문 보존형 경로로 재처리해 결과를 보장.
#   보존형 결과엔 보존형(다듬기) 단가(100자당 1)만 차감. 끄려면 0/off/false → 막다른 길(차단) 유지.
# TRANSFORM_BLOCK_FALLBACK=1

# ── 근거 검색(P4) 튜닝 — 미설정 시 기본값 ──
# EVIDENCE_MAX_SEGMENTS=6
# EVIDENCE_APPROVE_CAP=     # 기본: 공백 제외 350자당 1건 (8~18 사이 자동)
# EVIDENCE_MODEL=

# ── GPT 운영 엔진(runtime config fallback) ───────────
# 관리자 페이지(adminSettings/gptRuntimeConfig)가 있으면 Firestore 값이 우선한다.
# 운영 provider는 LLM_ACTIVE_PROVIDER 한 곳에서만 설정한다.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_ACTIVE_PROVIDER=gpt
# OPENAI_MODEL_FAST=gpt-5.4-mini
# OPENAI_MODEL_MAIN=gpt-5.4
# OPENAI_MODEL_ESCALATION=gpt-5.4
# OPENAI_MODEL_JUDGE=gpt-5.4-mini
# OPENAI_MODEL_REPAIR=gpt-5.4-mini
# OPENAI_MODEL_CLASSIFY=gpt-5.4-nano
# OPENAI_MODEL_DETECT=gpt-5.4-mini
# OPENAI_MODEL_DETECT_ESCALATION=gpt-5.4
# OPENAI_MODEL_EVIDENCE=gpt-5.4-mini
# OPENAI_MODEL_EVIDENCE_ESCALATION=gpt-5.4
# OPENAI_REASONING_HUMANIZE=low
# OPENAI_REASONING_FACT_DENSE=medium
# OPENAI_REASONING_ESCALATION=medium
# OPENAI_REASONING_JUDGE=medium
# OPENAI_REASONING_REPAIR=medium
# OPENAI_REASONING_CLASSIFY=low
# OPENAI_REASONING_DETECT=low
# OPENAI_REASONING_EVIDENCE=medium
# OPENAI_TEXT_VERBOSITY=medium
# OPENAI_PROMPT_CACHE_ENABLED=1
# OPENAI_PROMPT_CACHE_KEY_PREFIX=gp-v9-cksafe-ko-p20260704
# OPENAI_PROMPT_CACHE_RETENTION=
# OPENAI_WEB_SEARCH_TOOL_TYPE=web_search
# GPT_EVIDENCE_URL_VERIFY_TIMEOUT_MS=6000
# GPT_ESCALATION_ENABLED=1
# GPT_ESCALATION_LONG_TEXT_CHARS=9000
# GPT_ESCALATION_PROTECTED_TERM_THRESHOLD=35
# GPT_ESCALATION_PATCH_TARGET_THRESHOLD=24

# ── Discord 운영 알림(선택) ─────────────────────────
# 디스코드 채널 설정 → 연동 → 웹훅 만들기로 URL 생성 후 입력. 셋(채널별)이 없으면 DISCORD_WEBHOOK_URL 단일 채널로 폴백.
# 하나도 없으면 알림 전체 비활성(no-op) — 코드는 항상 안전하게 동작.
#   cs     : 새 문의 · 환불 요청 · 정기결제 실패(past_due)   (즉시 대응)
#   sales  : 결제 완료 · 구독 시작/해지/갱신                  (매출)
#   alert  : error/fatal 로그(장애) — 로그 시스템 연동, 같은 에러 30초 중복 억제
#   growth : 신규 가입 · 쿠폰 사용 · 친구 초대 성공           (성장)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_CS=
DISCORD_WEBHOOK_SALES=
DISCORD_WEBHOOK_ALERT=
DISCORD_WEBHOOK_GROWTH=

# ── Discord 슬래시 커맨드 봇: 매출 조회(선택) ─────────
# 디스코드에서 /매출 [오늘|어제|이번주|이번달] 으로 집계 매출을 조회. 설정 절차는 DISCORD-BOT.md 참고.
# Discord Developer Portal(https://discord.com/developers/applications) 에서 발급:
DISCORD_APP_ID=          # General Information > Application ID
DISCORD_PUBLIC_KEY=      # General Information > Public Key (서명검증용, 필수)
DISCORD_BOT_TOKEN=       # Bot > Token (슬래시 커맨드 등록 스크립트용)
DISCORD_GUILD_ID=        # (선택) 테스트 서버 ID — 있으면 명령 즉시 등록, 없으면 글로벌(최대 1h)

# ── 매출 온디맨드 조회 엔드포인트(/admin/revenue) 보호 토큰 ──
# 길고 무작위한 문자열로. GET /admin/revenue?token=...&period=today
ADMIN_TOKEN=

# (참고) 일일 매출 리포트 cron(POST /cron/daily-revenue)은 위의 CRON_SECRET 을 재사용합니다.
# 운영 휴머나이징 엔진 v2. 0이면 한 릴리스 동안 보존하는 기존 경로로 즉시 복귀합니다.
HUMANIZE_ENGINE_V2_ENABLED=0
# Firebase UID를 OpenAI safety_identifier로 보낼 때 사용하는 HMAC 비밀값(원본 UID는 전송하지 않음).
OPENAI_SAFETY_SALT=
# 국립국어원 외부 API는 기본 비활성. 로컬 리소스 기반 검사는 계속 사용합니다.
GPT_NIKL_EXTERNAL_API_ENABLED=0
