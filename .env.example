# 운영 AI는 OpenAI 단일 경로다. 모델 설정은 아래 runtime config fallback
# 섹션에서 관리하며 provider 전환용 환경변수는 사용하지 않는다.

# ── 서버 구동(server.js)용 — 로컬 엔진 테스트엔 불필요 ──
# 미설정 시 Firebase 비활성(엔진 단독 테스트 모드). 프로덕션/staging에서만 설정(서비스 계정 JSON 통째로).
FIREBASE_SERVICE_ACCOUNT=
# 커뮤니티 Storage 토큰 회수 도구에서만 사용. Firebase Console의 정확한 bucket 이름.
FIREBASE_STORAGE_BUCKET=
# Kakao access-token audience(app_id) 검증. 앱 설정의 숫자 App ID를 넣고 검증 후 REQUIRE를 1로 전환한다.
KAKAO_APP_ID=
KAKAO_REQUIRE_APP_ID=0
KAKAO_CUSTOM_TOKEN_AUTH_ENABLED=0
# 미설정 시 OPENAI_SAFETY_SALT를 도메인 분리해 Kakao UID·로그 식별자 HMAC에 사용한다.
KAKAO_AUTH_SALT=
AUTH_RATE_LIMIT_PER_10_MIN=20
ADMIN_RATE_LIMIT_PER_MIN=240
# 회원 탈퇴는 auth_time 기준 최근 15분 로그인만 허용한다(60~3600초).
ACCOUNT_DELETE_MAX_AUTH_AGE_SEC=900
# 탈퇴 tombstone·재무 보존 식별자를 위한 HMAC. 미설정 시 OPENAI_SAFETY_SALT를 사용한다.
ACCOUNT_DELETION_SECRET=
# 추천은 가입 후 7일 안에 등록하고 첫 결제를 확인한 뒤 환불 가능 기간이 끝나면 양쪽에 20크레딧을 한 번만 지급한다.
REFERRAL_VESTING_SECRET=
REFERRAL_REWARD_CREDITS=20
REFERRAL_APPLY_WINDOW_DAYS=7
REFERRAL_DAILY_ATTEMPT_CAP=10
# 기본 허용 도메인(gpkorea.ai.kr) 외 추가 origin — 콤마 구분 (예: https://staging.gpkorea.ai.kr)
CORS_ORIGINS=
# staging/preview 전용 origin suffix — 예: .vercel.app. 프로덕션에서는 비워둘 것.
CORS_ORIGIN_SUFFIXES=
# Meta Conversions API (서버 전환). 토큰은 Event Manager에서 생성해 운영 환경변수로만 보관한다.
META_DATASET_ID=1575815300659999
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
# 이벤트 관리자 테스트 시에만 임시 설정하고 검증 후 비운다.
META_CAPI_TEST_EVENT_CODE=
META_CAPI_TIMEOUT_MS=2500
# 정기결제 갱신 cron 호출 인증용 시크릿
CRON_SECRET=
# Toss 승인 후 Firestore 반영이 지연된 구독 주문의 자동 재정산 한도.
# process-due가 시간당 재조회하며, 한도를 넘기면 manual_review로 전환한다.
SUBSCRIPTION_RECONCILIATION_MAX_ATTEMPTS=6
SUBSCRIPTION_RECONCILIATION_MAX_AGE_MS=86400000
# 무파손 마이그레이션: 1이면 과거 ?key= 호출을 경고와 함께 허용. 모든 cron을
# x-cron-secret 헤더로 바꾼 뒤 반드시 0으로 전환.
CRON_ALLOW_QUERY_SECRET=1
# /admin/revenue의 과거 ?token= 호환. 관리자 화면/도구를 x-admin-token으로 옮긴 뒤 0.
ADMIN_ALLOW_QUERY_TOKEN=1
# 상세 /api/health 전용 x-health-secret. 공개 /healthz·/livez는 최소 정보만 반환.
HEALTH_DETAIL_SECRET=
# cf-connecting-ip를 신뢰할 수 있도록 Cloudflare-only ingress를 강제한 경우에만 1.
TRUST_CF_CONNECTING_IP=0
# 토스페이먼츠 시크릿 키(결제·환불) — 프로덕션은 live_, 테스트는 test_ 키
TOSS_SECRET_KEY=
# Toss 웹훅 처리용 내부 검증 시크릿. 미설정 시 /toss/webhook은 fail-close(503)한다.
# Toss 콘솔/프록시에서 x-gp-webhook-secret 또는 Authorization: Bearer 헤더로 같은 값을 전달해야 한다.
TOSS_WEBHOOK_SECRET=
PORT=3100

# ── 글쓰기 랩 v2 ───────────────────────────────────
# 검수 원장 토큰 HMAC 비밀값. 운영 필수이며 UTF-8 기준 32바이트 이상 무작위 값으로 설정한다.
WRITING_LAB_CONTEXT_SECRET=
# 비상 전체 롤백(0) / 활성(1). 기본 활성. 노출 비율은 UID 고정 버킷으로 0~100 사이 지정.
WRITING_LAB_V2_ENABLED=1
WRITING_LAB_V2_ROLLOUT_PERCENT=100
# 장르 단위 롤백. resume,review_blog,marketing,general 중 쉼표로 구분.
WRITING_LAB_V2_DISABLED_GENRES=
# 성공한 공개 가능 초안만 집계하는 일일 한도와 보조 API 시간당 한도.
WRITING_LAB_DAILY_CAP=30
WRITING_LAB_CHECK_HOURLY_CAP=120
WRITING_LAB_EXTRACT_HOURLY_CAP=30
# 1이면 의료·법률·금융·광고 정책 팩 4종의 실제 담당자 승인이 없을 때 predeploy를 차단한다.
# 비규제 베타는 0으로 두되 규제 감지 요청이 MANUAL_REVIEW로 fail-close되는지 확인한다.
WRITING_LAB_REQUIRE_ALL_POLICY_APPROVAL=0
# 알려진 품질 문제가 있는 v1 공개 경로는 기본 종료. 긴급 호환이 꼭 필요할 때만 1.
WRITING_LAB_V1_PUBLIC=0

# ── 운영 점검 모드 ───────────────────────────────────
# true면 비용/결제/쓰기성 API를 503으로 닫는다. /healthz, /api/health, /kakao-login은 허용.
# 테스트 브라우저에서 localStorage.gp_maintenance_bypass에 같은 값을 넣으면 X-Maintenance-Bypass 헤더로 우회 가능.
# 예: localStorage.setItem('gp_maintenance_bypass','랜덤긴시크릿')
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_SECRET=

# ── 로컬 개발 전용 — 프로덕션에서 절대 설정 금지 ──
# FIREBASE_SERVICE_ACCOUNT가 비어 있을 때만 동작(인증 우회). Firebase 설정 시 자동 무시되지만 켜두지 말 것.
# DEV_NO_AUTH=1

# ── AI 감지(/detect-report) ─────────────────────────
# 모든 감지는 로그인·크레딧 선검증을 거치는 유료 경로다.
# 테스트 오픈 임시 보정: 로그인 사용자의 최근 작업내역(history) 중 휴머나이저 결과와 감지 입력이
# 공백 정규화 후 같거나, 장문에서 길이 차이 3% 이내·5-gram 유사도 0.88 이상이면 감지 확률을 보정한다.
# 다른 사용자의 글, 짧은 글의 유사 일치, 길이가 크게 달라진 글에는 적용하지 않는다.
# 원점수(rawProbability)와 보정 메타는 저장/관리자 조회에 남긴다.
# 관리자 페이지 저장값(adminSettings/detectCalibration)이 있으면 env보다 우선 적용된다. 정식 오픈 전 반드시 재검토.
# DETECT_HISTORY_CALIBRATION=0
# DETECT_HISTORY_CALIBRATION_LIMIT=50
# DETECT_HISTORY_CALIBRATION_FACTOR=0.15
# DETECT_HISTORY_CALIBRATION_MAX_REDUCTION=12
# DETECT_HISTORY_CALIBRATION_FLOOR=35
# DETECT_HISTORY_CALIBRATION_APPROXIMATE_MATCH=1
# DETECT_HISTORY_CALIBRATION_SIMILARITY_THRESHOLD=0.88
# DETECT_HISTORY_CALIBRATION_MAX_LENGTH_DELTA_RATIO=0.03
# DETECT_HISTORY_CALIBRATION_MIN_APPROXIMATE_CHARS=500
# 서버가 저장한 휴머나이징 이력의 출처 HMAC. 미설정 시 OPENAI_SAFETY_SALT를 도메인 분리해 사용한다.
# HISTORY_PROVENANCE_SECRET=
# 코치 제안은 로그인 필수이며 UID별 Firestore 시간당 한도를 적용한다.
# COACH_UID_HOURLY_CAP=20
# 프런트 App Check 토큰 배포를 확인한 뒤 1로 전환한다.
# COACH_APPCHECK_ENFORCE=0

# ── 변환 job(/transform) 비용 방어 — 미설정 시 기본값 ──
# 전역 동시 실행 상한(LLM 점유 job 수). formal(고급 피하기·재구성) 기본 3 — 인스턴스 사양·API rate limit에 맞춰 조정.
# RESTRUCTURE_MAX_ACTIVE=3
# blog(기본 피하기) 전역 동시 상한. 짧고 저원가라 별도 풀, 기본 4.
# BLOG_MAX_ACTIVE=4
# 사용자당 일일 시작 횟수(취소·차단 포함 — 최악 비용 캡). formal만 적용, 기본 8.
# RESTRUCTURE_DAILY_CAP=8
# 기본 휴머나이징 차단 작업에서 사용자가 명시적으로 선택하는 다듬기 폴백. 고급에는 적용하지 않음.
#   다듬기 단가(100자당 1)를 차감하며, 끄려면 0/off/false.
# TRANSFORM_BLOCK_FALLBACK=1

# ── 근거 검색(P4) 튜닝 — 미설정 시 기본값 ──
# EVIDENCE_MAX_SEGMENTS=6
# EVIDENCE_APPROVE_CAP=     # 기본: 공백 제외 350자당 1건 (8~18 사이 자동)
# EVIDENCE_MODEL=

# ── GPT 운영 엔진(runtime config fallback) ───────────
# 관리자 페이지(adminSettings/gptRuntimeConfig)가 있으면 Firestore 값이 우선한다.
# 운영 provider는 코드에서 OpenAI로 고정하며 이 섹션은 모델·추론 설정만 다룬다.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL_FAST=gpt-5.6-luna
# OPENAI_MODEL_MAIN=gpt-5.6-terra
# OPENAI_MODEL_ESCALATION=gpt-5.6-terra
# OPENAI_MODEL_JUDGE=gpt-5.6-luna
# OPENAI_MODEL_JUDGE_ESCALATION=gpt-5.6-terra
# OPENAI_MODEL_REPAIR=gpt-5.6-luna
# OPENAI_MODEL_CLASSIFY=gpt-5.6-luna
# OPENAI_MODEL_DETECT=gpt-5.6-luna
# OPENAI_MODEL_DETECT_ESCALATION=gpt-5.6-terra
# OPENAI_MODEL_EVIDENCE=gpt-5.6-luna
# OPENAI_MODEL_EVIDENCE_ESCALATION=gpt-5.6-terra
# OPENAI_REASONING_HUMANIZE=medium
# OPENAI_REASONING_FACT_DENSE=high
# OPENAI_REASONING_ESCALATION=high
# OPENAI_REASONING_JUDGE=medium
# OPENAI_REASONING_REPAIR=medium
# OPENAI_REASONING_CLASSIFY=low
# OPENAI_REASONING_DETECT=low
# OPENAI_REASONING_EVIDENCE=medium
# OPENAI_PROMPT_CACHE_ENABLED=1
# OPENAI_PROMPT_CACHE_KEY_PREFIX=gp-v9-cksafe-ko-p20260704
# OPENAI_PROMPT_CACHE_KEY_INCLUDE_MODE=0
# OPENAI_PROMPT_CACHE_KEY_INCLUDE_PHASE=0
# OPENAI_PROMPT_CACHE_RETENTION=
# OPENAI_WEB_SEARCH_TOOL_TYPE=web_search
# GPT_EVIDENCE_URL_VERIFY_TIMEOUT_MS=6000
# GPT_ESCALATION_ENABLED=1
# GPT_ESCALATION_LONG_TEXT_CHARS=9000
# GPT_ESCALATION_PROTECTED_TERM_THRESHOLD=35
# GPT_ESCALATION_PATCH_TARGET_THRESHOLD=24

# ── Discord 운영 알림(선택) ─────────────────────────
# 디스코드 채널 설정 → 연동 → 웹훅 만들기로 URL 생성 후 입력. 셋(채널별)이 없으면 DISCORD_WEBHOOK_URL 단일 채널로 폴백.
# 하나도 없으면 알림 전체 비활성(no-op) — 코드는 항상 안전하게 동작.
#   cs     : 새 문의 · 환불 요청 · 정기결제 실패(past_due)   (즉시 대응)
#   sales  : 결제 완료 · 구독 시작/해지/갱신                  (매출)
#   alert  : error/fatal 로그(장애) — 로그 시스템 연동, 같은 에러 30초 중복 억제
#   growth : 신규 가입 · 쿠폰 사용 · 친구 초대 성공           (성장)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_CS=
DISCORD_WEBHOOK_SALES=
DISCORD_WEBHOOK_ALERT=
DISCORD_WEBHOOK_GROWTH=

# ── Discord 슬래시 커맨드 봇: 매출 조회(선택) ─────────
# 디스코드에서 /매출 [오늘|어제|이번주|이번달] 으로 집계 매출을 조회. 설정 절차는 DISCORD-BOT.md 참고.
# Discord Developer Portal(https://discord.com/developers/applications) 에서 발급:
DISCORD_APP_ID=          # General Information > Application ID
DISCORD_PUBLIC_KEY=      # General Information > Public Key (서명검증용, 필수)
DISCORD_BOT_TOKEN=       # Bot > Token (슬래시 커맨드 등록 스크립트용)
DISCORD_GUILD_ID=        # (선택) 테스트 서버 ID — 있으면 명령 즉시 등록, 없으면 글로벌(최대 1h)
# /매출은 아래 사용자 또는 역할 중 하나와 일치해야 한다(둘 다 비면 fail-close).
DISCORD_REVENUE_ALLOWED_USER_IDS=   # 콤마 구분 Discord user ID
DISCORD_REVENUE_ALLOWED_ROLE_IDS=   # 콤마 구분 Discord role ID
DISCORD_REVENUE_ALLOWED_GUILD_IDS=  # 콤마 구분. 비면 DISCORD_GUILD_ID를 사용

# ── 매출 온디맨드 조회 엔드포인트(/admin/revenue) 보호 토큰 ──
# 길고 무작위한 문자열로. GET /admin/revenue?token=...&period=today
ADMIN_TOKEN=

# (참고) 일일 매출 리포트 cron(POST /cron/daily-revenue)은 위의 CRON_SECRET 을 재사용합니다.
# v2.4.8 장문 섹션 회복. 운영 기본값은 1이며 비용·시간 초과 시 0으로 개별 복귀합니다.
HUMANIZE_SECTION_RECOVERY_ENABLED=1
# 원문 대비 신규 상투구·부정→가산 논리 변환 감사. 운영 기본값은 1입니다.
HUMANIZE_FINGERPRINT_AUDIT_ENABLED=1
# 효과 제한 입력의 결제 전 사용자 확인. v2.4.8 프런트와 함께 1로 사용합니다.
HUMANIZE_EFFECT_CONFIRMATION_ENABLED=1
# Firebase UID를 OpenAI safety_identifier로 보낼 때 사용하는 HMAC 비밀값(원본 UID는 전송하지 않음).
OPENAI_SAFETY_SALT=
# 국립국어원 공개 데이터의 쉬운 말 후보는 일반 독자용 프로필에서만
# 비차단 프롬프트 힌트로 사용합니다. 학술·법률·자소서·창작에는 적용하지 않습니다.
GPT_NIKL_LOCAL_RESOURCE_ENABLED=1
# 외부 사전 API는 기본 활성입니다. 문서당 개인정보가 아닌 용어
# 후보 최대 2개만 조회하며 표기 보존 힌트로만 사용합니다.
GPT_NIKL_EXTERNAL_API_ENABLED=1
GPT_NIKL_API_PROVIDERS=opendict,stdict,term
GPT_NIKL_API_LOOKUP_MAX=2
NIKL_API_TIMEOUT_MS=1200
NIKL_OPENDICT_API_KEY=
NIKL_STDICT_API_KEY=
NIKL_TERM_API_KEY=
