# ── 엔진 LLM 백엔드 선택 ───────────────────────────────
# api        : Anthropic API 직접 호출 (ANTHROPIC_API_KEY 필요) — 프로덕션/최종 acceptance
# claudecode : 내 Claude Code 구독(Sonnet)으로 호출 (키 불필요) — 로컬 엔진 테스트 전용
#              ⚠️ 서버를 claudecode로 띄우면 UI 변환이 전부 타임아웃 난다(직렬·호출당 ~45초).
LLM_BACKEND=claudecode

# api 백엔드용
ANTHROPIC_API_KEY=

# ── 서버 구동(server.js)용 — 로컬 엔진 테스트엔 불필요 ──
# 미설정 시 Firebase 비활성(엔진 단독 테스트 모드). 프로덕션/staging에서만 설정(서비스 계정 JSON 통째로).
FIREBASE_SERVICE_ACCOUNT=
# 기본 허용 도메인(gpkorea.ai.kr) 외 추가 origin — 콤마 구분 (예: https://staging.gpkorea.ai.kr)
CORS_ORIGINS=
# staging/preview 전용 origin suffix — 예: .vercel.app. 프로덕션에서는 비워둘 것.
CORS_ORIGIN_SUFFIXES=
# 정기결제 갱신 cron 호출 인증용 시크릿
CRON_SECRET=
# 토스페이먼츠 시크릿 키(결제·환불) — 프로덕션은 live_, 테스트는 test_ 키
TOSS_SECRET_KEY=
# Toss 웹훅 처리용 내부 검증 시크릿. 미설정 시 /toss/webhook은 fail-close(503)한다.
# Toss 콘솔/프록시에서 x-gp-webhook-secret 또는 Authorization: Bearer 헤더로 같은 값을 전달해야 한다.
TOSS_WEBHOOK_SECRET=
PORT=3100

# ── 로컬 개발 전용 — 프로덕션에서 절대 설정 금지 ──
# FIREBASE_SERVICE_ACCOUNT가 비어 있을 때만 동작(인증 우회). Firebase 설정 시 자동 무시되지만 켜두지 말 것.
# DEV_NO_AUTH=1

# ── 레거시 PDF 직접 분석 API ───────────────────────
# 프론트는 브라우저에서 PDF 텍스트를 추출한 뒤 /analyze를 호출한다.
# /analyze-pdf는 과금 산식이 달라 운영 기본값에서 닫혀 있으며, 호환 필요 시에만 1로 켠다.
# ENABLE_LEGACY_ANALYZE_PDF=1

# ── AI 감지(/detect-report) — 무료 미끼 상품 ──
# 사용자(로그인 uid, 비로그인 IP)당 일일 무료 감지 횟수. 기본 5. 감지 1회 원가 ≈ LLM 판정+1문장 미리보기.
# DETECT_DAILY_CAP=5

# ── 변환 job(/transform) 비용 방어 — 미설정 시 기본값 ──
# 전역 동시 실행 상한(LLM 점유 job 수). formal(고급 피하기·재구성) 기본 3 — 인스턴스 사양·API rate limit에 맞춰 조정.
# RESTRUCTURE_MAX_ACTIVE=3
# blog(기본 피하기) 전역 동시 상한. 짧고 저원가라 별도 풀, 기본 4.
# BLOG_MAX_ACTIVE=4
# 사용자당 일일 시작 횟수(취소·차단 포함 — 최악 비용 캡). formal만 적용, 기본 8.
# RESTRUCTURE_DAILY_CAP=8

# ── 근거 검색(P4) 튜닝 — 미설정 시 기본값 ──
# EVIDENCE_MAX_SEGMENTS=6
# EVIDENCE_APPROVE_CAP=     # 기본: 공백 제외 350자당 1건 (8~18 사이 자동)
# EVIDENCE_MODEL=
