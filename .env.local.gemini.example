# Local-only Gemini test env. Copy to .env.local.gemini and fill keys.
# Do not use this file for production or Render.

PORT=3100
DEV_NO_AUTH=1
FIREBASE_SERVICE_ACCOUNT=

LLM_BACKEND=gemini
LLM_ROUTING_PROFILE=gemini_super_conservative
LLM_CLAUDE_FALLBACK=1
LLM_SHADOW_MODE=1
LLM_SHADOW_RATE=1.0

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini 3 thinking/caching controls. Implicit caching is automatic on supported Gemini models.
GEMINI_THINKING_PRO=high
GEMINI_THINKING_FLASH=medium
GEMINI_THINKING_LITE=minimal
GEMINI_THINKING_STRUCTURED_SHORT=minimal
GEMINI_THINKING_STRUCTURED_DETECT=low
GEMINI_EXPLICIT_CACHE=0
GEMINI_CACHE_TTL=3600s
GEMINI_EXPLICIT_CACHE_MIN_CHARS=6000
GEMINI_SEARCH_GROUNDING=1

# Claude remains available only for local shadow/fallback comparison.
EVIDENCE_MODEL=claude-sonnet-4-6

# Make local queues fast and cheap to observe.
RESTRUCTURE_MAX_ACTIVE=1
BLOG_MAX_ACTIVE=1
TRANSFORM_QUEUE_TICK_MS=1000
CANCEL_WINDOW_SEC=45
