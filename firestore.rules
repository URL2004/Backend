rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid in [
        'nC90IyjgaIZ8Z0JTABMTiyQHF9g1',
        'qa0iQAeVmMOxoy6Vg5ENTRKk0Vm2',
        'upyxtXMQEgQXfqTUWPrf6QS9EqE2',
        '9i6YA66mpXSBcpPJqNmJQ5jnJsT2'
      ];
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys);
    }

    function validAttributionTouch(touch) {
      return touch is map
        && touch.keys().hasOnly([
          'version', 'captured_at', 'source', 'medium', 'campaign', 'content', 'term',
          'napm', 'gclid', 'fbclid', 'landing_path', 'landing_url', 'referrer_host'
        ])
        && touch.get('version', 1) == 1
        && touch.get('captured_at', '') is string && touch.get('captured_at', '').size() <= 40
        && touch.get('source', '') is string && touch.get('source', '').size() <= 100
        && touch.get('medium', '') is string && touch.get('medium', '').size() <= 100
        && touch.get('campaign', '') is string && touch.get('campaign', '').size() <= 250
        && touch.get('content', '') is string && touch.get('content', '').size() <= 250
        && touch.get('term', '') is string && touch.get('term', '').size() <= 250
        && touch.get('napm', '') is string && touch.get('napm', '').size() <= 500
        && touch.get('gclid', '') is string && touch.get('gclid', '').size() <= 250
        && touch.get('fbclid', '') is string && touch.get('fbclid', '').size() <= 250
        && touch.get('landing_path', '') is string && touch.get('landing_path', '').size() <= 250
        && touch.get('landing_url', '') is string && touch.get('landing_url', '').size() <= 500
        && touch.get('referrer_host', '') is string && touch.get('referrer_host', '').size() <= 250;
    }

    function validSignupAttribution(value) {
      return value is map
        && value.keys().hasOnly(['first_touch', 'last_touch'])
        && validAttributionTouch(value.first_touch)
        && validAttributionTouch(value.last_touch);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'credits', 'plan', 'refCode', 'createdAt', 'signupAttribution'])
        && request.resource.data.credits == 10
        && request.resource.data.plan == 'free'
        && (!request.resource.data.keys().hasAny(['signupAttribution'])
            || validSignupAttribution(request.resource.data.signupAttribution))
        // ★ C-08: refCode는 uid 앞 8자로 결정. 사용자가 임의 코드를 고르거나 충돌시킬 수 없다.
        && request.resource.data.refCode == (request.auth.uid.size() >= 8 ? request.auth.uid[0:8] : request.auth.uid);

      allow update: if isSelf(uid)
        && onlyChanged(['name', 'refCode'])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['name'])
            || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        // ★ C-08: refCode를 바꿀 땐 반드시 uid 앞 8자로만(백필 허용·임의변경 차단). 안 바꾸면 통과.
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['refCode'])
            || request.resource.data.refCode == (request.auth.uid.size() >= 8 ? request.auth.uid[0:8] : request.auth.uid));

      allow delete: if false;

      match /history/{historyId} {
        // 이용 기록은 과금·감지·변환 서버가 Admin SDK로만 생성한다.
        // 클라이언트가 임의 결과를 주입하면 감지 보정과 운영 통계의 신뢰 경계가 깨진다.
        allow read, delete: if isSelf(uid);
        allow create, update: if false;
      }

      match /notifications/{notificationId} {
        // 커뮤니티 폐쇄 후 클라이언트 알림 생성도 닫는다. Q&A·운영 알림은 서버
        // Admin SDK가 생성하고, 사용자는 자기 알림의 조회·확인·삭제만 할 수 있다.
        allow read, delete: if isSelf(uid) || isAdmin();
        allow update: if isAdmin()
          || (isSelf(uid) && onlyChanged(['read']) && request.resource.data.read == true);
        allow create: if isAdmin();
      }

      match /creditHistory/{historyId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      match /couponHistory/{historyId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /subscriptionOrders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ★ C-03: 결제 비밀(billingKey)은 서버 전용. 본인조차 클라이언트에서 직접 읽을 수 없다.
    match /billingSecrets/{uid} {
      allow read, write: if false;
    }

    // ★ C-04: 결제 운영키(paymentKey)도 서버 전용 — 환불에만 서버가 사용.
    match /paymentSecrets/{orderId} {
      allow read, write: if false;
    }

    // External approval and internal fulfillment state. Server-only reconciliation data.
    match /paymentIntents/{orderId} {
      allow read, write: if false;
    }

    // Provider cancellation reconciliation and any unrecovered-credit balance are server-only.
    match /systemCreditReconciliations/{reconciliationId} {
      allow read, write: if false;
    }

    match /couponCodes/{code} {
      allow read, write: if false;
    }

    match /couponBatches/{batchId} {
      allow read, write: if false;
    }

    match /transformJobs/{jobId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /transformJobArchive/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhookLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ★ C-07: 웹훅 이벤트 멱등 inbox — 서버 전용.
    match /webhookInbox/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /posts/{postId} {
      // 커뮤니티는 운영 폐쇄 상태다. 데이터를 삭제하지는 않되 URL 직접 접근이나
      // 구버전 클라이언트와 관리자 웹 세션에서도 읽거나 쓰지 못하게 한다. 보존·법적
      // 대응이 필요할 때만 감사된 서버 Admin SDK 도구를 사용한다.
      allow read, create, update, delete: if false;

      match /comments/{commentId} {
        allow read, create, update, delete: if false;
      }
    }

    match /qna/{questionId} {
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'authorId', 'authorName', 'isAnon',
          'status', 'answer', 'createdAt', 'views'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.answer == null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.isAnon is bool
        && request.resource.data.views == 0
        && request.resource.data.createdAt == request.time;

      // 1:1 문의: 관리자는 전체 목록, 일반 사용자는 본인 문의만 목록 조회 가능.
      // list 규칙은 매칭되는 각 문서에 대해 평가되므로, 클라이언트가 where('authorId','==',uid)로
      // 질의해야(본인 문서만 매칭) 통과한다. where 없이 전체를 질의하면 거부된다.
      allow list: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow get: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);

      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 운영 장애 로그·하트비트: 서버(Admin SDK)만 쓰고 읽는다.
    // 관리자 화면도 Firestore를 직접 읽지 않고 /admin/ops-* API를 거친다 — 클라이언트에
    // uid·주문번호·스택이 담긴 사건 기록을 절대 직접 노출하지 않기 위해서다.
    // (아래 catch-all로도 막히지만, 의도를 명시해 나중에 실수로 열리는 것을 방지한다.)
    match /opsLogs/{docId} {
      allow read, write: if false;
    }
    match /opsHeartbeats/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
