rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid in [
        'nC90IyjgaIZ8Z0JTABMTiyQHF9g1',
        'qa0iQAeVmMOxoy6Vg5ENTRKk0Vm2',
        'upyxtXMQEgQXfqTUWPrf6QS9EqE2',
        '9i6YA66mpXSBcpPJqNmJQ5jnJsT2'
      ];
    }

    function onlyChanged(keys) {
      // changedKeys() excludes newly added and removed fields. affectedKeys()
      // closes the field-addition bypass while preserving the intended allowlist.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validAttributionTouch(touch) {
      return touch is map
        && touch.keys().hasOnly([
          'version', 'captured_at', 'source', 'medium', 'campaign', 'content', 'term',
          'napm', 'gclid', 'fbclid', 'use_case', 'landing_path', 'landing_url', 'referrer_host'
        ])
        && touch.get('version', 1) == 1
        && touch.get('captured_at', '') is string && touch.get('captured_at', '').size() <= 40
        && touch.get('source', '') is string && touch.get('source', '').size() <= 100
        && touch.get('medium', '') is string && touch.get('medium', '').size() <= 100
        && touch.get('campaign', '') is string && touch.get('campaign', '').size() <= 250
        && touch.get('content', '') is string && touch.get('content', '').size() <= 250
        && touch.get('term', '') is string && touch.get('term', '').size() <= 250
        && touch.get('napm', '') is string && touch.get('napm', '').size() <= 500
        && touch.get('gclid', '') is string && touch.get('gclid', '').size() <= 250
        && touch.get('fbclid', '') is string && touch.get('fbclid', '').size() <= 250
        && touch.get('use_case', '') is string && touch.get('use_case', '').size() <= 40
        && touch.get('landing_path', '') is string && touch.get('landing_path', '').size() <= 250
        && touch.get('landing_url', '') is string && touch.get('landing_url', '').size() <= 500
        && touch.get('referrer_host', '') is string && touch.get('referrer_host', '').size() <= 250;
    }

    function validSignupAttribution(value) {
      return value is map
        && value.keys().hasOnly(['first_touch', 'last_touch'])
        && validAttributionTouch(value.first_touch)
        && validAttributionTouch(value.last_touch);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // 초기 25크레딧 지급은 클라이언트가 임의 계정을 만들어 반복 지급받는 비용 표면이다.
      // /account/initialize가 Firebase 인증과 UID·접속지 지속 quota를 통과한 뒤 Admin SDK로만 생성한다.
      allow create: if false;

      allow update: if isSelf(uid)
        // kakaoId is an authentication binding and must only be written by the
        // backend Admin SDK after Kakao identity verification. bookmarks belonged
        // to the now-closed community and is no longer a client-writable field.
        && onlyChanged(['name', 'refCode'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
            || request.resource.data.name == null
            || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        // ★ C-08: refCode를 바꿀 땐 반드시 uid 앞 8자로만(백필 허용·임의변경 차단). 안 바꾸면 통과.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['refCode'])
            || request.resource.data.refCode == (request.auth.uid.size() >= 8 ? request.auth.uid[0:8] : request.auth.uid));

      allow delete: if false;

      match /history/{historyId} {
        allow read: if isSelf(uid);
        // 클라이언트 직접 쓰기는 비용 공격·위조 이력을 만든다.
        // 폴백 저장은 인증·트랜잭션 quota가 있는 /history/backup API만 사용한다.
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read, delete: if isSelf(uid);
        // 과거 알림의 필드 구성과 무관하게 unread→read 1회만 허용한다.
        // 토글·전체 재쓰기를 허용하면 같은 문서로 쓰기 비용을 무한 발생시킬 수 있다.
        allow update: if isSelf(uid)
          && onlyChanged(['read'])
          && resource.data.read == false
          && request.resource.data.read == true;
        // 새 알림은 Q&A 답변·운영 서버만 Admin SDK로 생성한다.
        // 본인 self-create도 닫아 무제한 쓰기 비용과 위조 알림을 차단한다.
        allow create: if false;
      }

      match /creditHistory/{historyId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      match /couponHistory/{historyId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /subscriptionOrders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Verified external-provider identity bindings. The backend Admin SDK owns
    // creation and resolution; exposing this map would enable account discovery
    // and client writes would enable identity-binding takeover.
    match /authIdentities/{identityId} {
      allow read, write: if false;
    }

    match /accountDeletionJobs/{uid} {
      allow read, write: if false;
    }

    // Active transform/writing leases serialize content writes with account
    // deletion. They are server-only and must never become client-controlled.
    match /accountActivityClaims/{uid} {
      allow read, write: if false;
    }

    // 신규 가입 접속 지문은 서버 비밀로 HMAC한 값만 저장하며 추천인
    // 자가보상·대량 가입 감사에만 사용한다. 클라이언트에는 노출하지 않는다.
    match /accountSecurity/{uid} {
      allow read, write: if false;
    }

    // 결제·구독·환불의 동시 요청 claim은 중복 지급과 청구/탈퇴 경쟁을
    // 막는 서버 트랜잭션 락이다. 소유자나 관리자 브라우저에도 노출하지 않는다.
    match /paymentAccountClaims/{uid} {
      allow read, write: if false;
    }

    match /subscriptionOperationClaims/{uid} {
      allow read, write: if false;
    }

    match /subscriptionRefundClaims/{claimId} {
      allow read, write: if false;
    }

    // ★ C-03: 결제 비밀(billingKey)은 서버 전용. 본인조차 클라이언트에서 직접 읽을 수 없다.
    match /billingSecrets/{uid} {
      allow read, write: if false;
    }

    // ★ C-04: 결제 운영키(paymentKey)도 서버 전용 — 환불에만 서버가 사용.
    match /paymentSecrets/{orderId} {
      allow read, write: if false;
    }

    // External approval and internal fulfillment state. Server-only reconciliation data.
    match /paymentIntents/{orderId} {
      allow read, write: if false;
    }

    // Provider cancellation reconciliation and any unrecovered-credit balance are server-only.
    match /systemCreditReconciliations/{reconciliationId} {
      allow read, write: if false;
    }

    match /couponCodes/{code} {
      allow read, write: if false;
    }

    match /couponBatches/{batchId} {
      allow read, write: if false;
    }

    match /transformJobs/{jobId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // 감지 응답 유실 복구용 서버 전용 캐시. 원문 일부가 응답 artifact에 포함될 수 있어
    // 인증 사용자에게도 직접 노출하지 않고 API의 payload-bound replay로만 반환한다.
    match /analyzeRequests/{requestId} {
      allow read, write: if false;
    }

    match /transformJobArchive/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhookLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ★ C-07: 웹훅 이벤트 멱등 inbox — 서버 전용.
    match /webhookInbox/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /posts/{postId} {
      // 커뮤니티는 제품에서 폐쇄됐다. 메뉴/라우트 차단만으로는 SDK 직접 접근을
      // 막을 수 없으므로 기존 데이터까지 포함해 모든 클라이언트 접근을 거부한다.
      // 계정 삭제 등 서버 Admin SDK 정리 작업은 Security Rules를 우회하므로 유지된다.
      allow read, write: if false;

      match /comments/{commentId} {
        allow read, write: if false;
      }
    }

    match /qna/{questionId} {
      // 문의 등록·삭제·답변은 인증·크기·UID quota를 검사하는 서버 API로만 수행한다.
      allow create: if false;

      // 1:1 문의: 관리자는 전체 목록, 일반 사용자는 본인 문의만 목록 조회 가능.
      // list 규칙은 매칭되는 각 문서에 대해 평가되므로, 클라이언트가 where('authorId','==',uid)로
      // 질의해야(본인 문서만 매칭) 통과한다. where 없이 전체를 질의하면 거부된다.
      allow list: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow get: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);

      allow update, delete: if false;
    }

    // 서버 API가 트랜잭션으로 관리하는 UID별 쓰기 예산. 클라이언트에는 조회도 허용하지 않는다.
    match /clientWriteQuotas/{quotaId} {
      allow read, write: if false;
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 운영 장애 로그·하트비트: 서버(Admin SDK)만 쓰고 읽는다.
    // 관리자 화면도 Firestore를 직접 읽지 않고 /admin/ops-* API를 거친다 — 클라이언트에
    // uid·주문번호·스택이 담긴 사건 기록을 절대 직접 노출하지 않기 위해서다.
    // (아래 catch-all로도 막히지만, 의도를 명시해 나중에 실수로 열리는 것을 방지한다.)
    match /opsLogs/{docId} {
      allow read, write: if false;
    }
    match /opsHeartbeats/{docId} {
      allow read, write: if false;
    }

    // 가입 무료 크레딧 측정 이벤트는 UID·IP 대신 서버 생성 hash key만 담는다.
    // 관리자 화면도 직접 조회하지 않고 /admin/signup-credit-summary의 집계만 사용한다.
    match /signupCreditEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
