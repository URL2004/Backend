{
  "name": "ai-backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "setup:layout-nlp": "node scripts/install-layout-nlp.js",
    "eval": "node eval/runEval.js",
    "report:fingerprints": "node scripts/humanize-fingerprint-report.js",
    "eval:profiles": "node scripts/replay-document-profiles.js",
    "eval:judge": "node eval/runJudgeEval.js",
    "test": "node --test test/*.test.js",
    "test:v2": "node --test test/humanize-v2*.test.js test/openai-client.test.js",
    "cache:gpt": "powershell -ExecutionPolicy Bypass -File scripts/openai-cache-logs.ps1",
    "test:cache": "node --test test/openai-cache.test.js",
    "check:production-imports": "node scripts/check-production-imports.js",
    "predeploy:v2": "node scripts/predeploy-v2.js",
    "test:rules": "node scripts/firestore-rules.test.mjs",
    "emulator:rules": "powershell -ExecutionPolicy Bypass -File scripts/run-firestore-rules.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "14.1.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.14.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "form-data": "^4.0.6",
    "protobufjs": "7.6.5",
    "rimraf": "6.1.3",
    "uuid": "11.1.1"
  }
}
