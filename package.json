{
  "name": "ai-backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "setup:layout-nlp": "node scripts/install-layout-nlp.js",
    "eval": "node eval/runEval.js",
    "report:fingerprints": "node scripts/humanize-fingerprint-report.js",
    "report:signup-credits": "node scripts/report-signup-credit-usage.js",
    "eval:profiles": "node scripts/replay-document-profiles.js",
    "audit:humanize-local": "node scripts/audit-local-humanize-pairs.js",
    "audit:humanize-text-local": "node scripts/audit-local-humanize-text-pairs.js",
    "eval:judge": "node eval/runJudgeEval.js",
    "test": "node --test test/*.test.js",
    "test:v2": "node --test test/humanize-v2*.test.js test/openai-client.test.js",
    "cache:gpt": "powershell -ExecutionPolicy Bypass -File scripts/openai-cache-logs.ps1",
    "test:cache": "node --test test/openai-cache.test.js",
    "check:production-imports": "node scripts/check-production-imports.js",
    "git:check": "node scripts/git-harness.js --mode=manual --remote-ref=origin/release/prod-maintenance-test --max-worktrees=4",
    "git:check:all": "node scripts/git-harness.js --mode=manual --all-worktrees=1",
    "git:install-hooks": "node scripts/install-git-hooks.js --workspace=1",
    "git:worktree:plan": "node scripts/git-worktree-cleanup.js",
    "git:worktree:clean": "node scripts/git-worktree-cleanup.js --apply=1",
    "predeploy:v2": "node scripts/predeploy-v2.js",
    "writing-policy:validate": "node scripts/writing-lab-policy.js validate",
    "writing-policy:approve": "node scripts/writing-lab-policy.js approve",
    "test:rules": "node scripts/firestore-rules.test.mjs",
    "emulator:rules": "powershell -ExecutionPolicy Bypass -File scripts/run-firestore-rules.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "14.1.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.14.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "brace-expansion": "5.0.9",
    "form-data": "^4.0.6",
    "protobufjs": "7.6.5",
    "qs": "6.16.0",
    "rimraf": "6.1.3",
    "uuid": "11.1.1"
  }
}
